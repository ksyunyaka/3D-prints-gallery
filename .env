# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API Keys).
#
# Use the key labelled "publishable" / "anon public" — it starts with
# `sb_publishable_` (or is a long `eyJ...` JWT on older projects).
#
# NEVER put a `sb_secret_` / service_role key in this file. Anything prefixed
# with VITE_ is compiled into the JavaScript bundle and served to every visitor,
# and a secret key bypasses row level security — it would let anyone edit or
# delete your gallery.

VITE_SUPABASE_URL=https://ifloeesincfnfutfcyxp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LHvrw7y0mHK8exIp01MQSw_rMeUnMpJ
